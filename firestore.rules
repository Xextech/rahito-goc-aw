rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidReservation(data) {
      return data.keys().hasAll(['date', 'time', 'guests', 'name', 'email', 'phone', 'status', 'createdAt', 'updatedAt'])
        && data.keys().size() >= 9
        && data.keys().size() <= 11
        && data.date is string && data.date.size() == 10
        && data.time is string && data.time.size() == 5
        && data.guests is int && data.guests > 0 && data.guests <= 20
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 100
        && data.phone is string && data.phone.size() >= 9 && data.phone.size() <= 20
        && data.status in ['confirmed', 'cancelled', 'attended']
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    match /reservations/{reservationId} {
      allow create: if isValidReservation(incoming());
      
      allow get: if true; // Allow checking reservation status by ID
      
      // Allow the restaurant owner / managers to list bookings
      allow list: if true;

      allow update: if (
        // Self-cancellation by customer
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        && incoming().status == 'cancelled'
        && incoming().updatedAt == request.time) || 
        // Authorized action internally (by owner via Google Auth or passphrase)
        (incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'tableId', 'tableName']))
      );
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
