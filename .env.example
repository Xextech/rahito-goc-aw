# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Nodemailer SMTP Configuration for Reservation Email Notifications
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
OWNER_EMAIL=

# Firestore access for the server (availability + reservation creation) uses
# Firebase Admin with Application Default Credentials — NOT an env var here.
# - Production (Cloud Run via AI Studio): automatic, uses the service's
#   attached identity. Nothing to configure.
# - Local development: run `gcloud auth application-default login` once,
#   or set GOOGLE_APPLICATION_CREDENTIALS to a service account key file.
# Without valid credentials, /api/availability and /api/reservations return
# 503 but the rest of the site keeps working.

# ADMIN_PASSPHRASE: passphrase for the owner dashboard (passphrase login).
# Never hardcode this in client code — it is checked server-side only.
ADMIN_PASSPHRASE=

